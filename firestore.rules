rules_version = '2';
// Quest Log access rules. Paste into Firebase console > Firestore Database > Rules > Publish.
// Only the two approved sign-in accounts can read anything. Only the parent account can
// replace the dashboard data. Both can save progress.
service cloud.firestore {
  match /databases/{database}/documents {
    function approved() {
      return request.auth != null &&
        request.auth.uid in ['viTdNXGQcWYRRHIAEziak8U6scM2', '5UMEqHWWrFPUYIupMNO9Lclq5cA3'];
    }
    function parent() {
      return request.auth != null && request.auth.uid == '5UMEqHWWrFPUYIupMNO9Lclq5cA3';
    }
    match /dashboard/{doc} {
      allow read: if approved();
      allow write: if parent();
    }
    match /progress/{doc} {
      allow read, write: if approved();
    }
    // Everything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
